# Настройки бэкенда Calendar. Скопируйте в server/.env и заполните.
# Файл .env читается вашим процессом (см. запуск), пример — без секретов.

# Порт бэкенда (по умолчанию 4010; под dev PORT занят Vite).
# BACKEND_PORT=4010

# Секрет подписи сессионной cookie. В production обязательно задать.
# SESSION_SECRET=change-me

# ── Email-уведомления (nodemailer) ──
# Если SMTP_HOST не задан — письма НЕ отправляются, только логируются в консоль.
# Пример для Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_SECURE=true,
# SMTP_USER=you@gmail.com, SMTP_PASS=<app-password> (не обычный пароль!).
# Для локальной отладки удобен Mailtrap / MailHog.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=Calendar <no-reply@calendar.local>
